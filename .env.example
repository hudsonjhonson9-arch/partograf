# Salin file ini menjadi .env (untuk `vercel dev` di lokal) lalu isi nilainya.
# Di Vercel Dashboard, isi nilai yang sama di Settings > Environment Variables.
# JANGAN commit file .env yang sudah berisi nilai asli ke Git.

# URL Web App Google Apps Script (code.gs) yang sudah di-deploy.
# Deploy: buka code.gs di editor Apps Script → Deploy → New deployment →
# type "Web app" → Execute as: yourself, Access: Anyone.
# Lalu salin URL https://script.google.com/macros/s/XXXX/exec ke sini.
APPS_SCRIPT_URL=
