# Salin file ini menjadi .env (untuk vercel dev di lokal) dan isi nilainya.
# Di Vercel Dashboard, isi nilai yang sama di Settings > Environment Variables.
# JANGAN commit file .env yang sudah berisi nilai asli ke Git.

# ID spreadsheet Google Sheets (ambil dari URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID=

# Email Service Account (dari file JSON kredensial, field "client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key Service Account (dari file JSON kredensial, field "private_key")
# Tempel APA ADANYA termasuk "-----BEGIN PRIVATE KEY-----" dan "-----END PRIVATE KEY-----"
# Jika disalin sebagai satu baris, ganti setiap baris baru menjadi karakter literal \n
GOOGLE_PRIVATE_KEY=
